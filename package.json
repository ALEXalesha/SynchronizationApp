{
  "name": "syncglass",
  "version": "1.2.3",
  "description": "Синхронизация папок между ноутбуком и сетевым компьютером с liquid glass интерфейсом",
  "main": "main.js",
  "author": "ALEXaloysha",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "dist:setup": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.syncglass.app",
    "productName": "SyncGlass",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SyncGlass"
    },
    "portable": {
      "artifactName": "SyncGlass-${version}-portable.exe"
    }
  }
}
