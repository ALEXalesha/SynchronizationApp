<Project Sdk="Microsoft.NET.Sdk">

  <!-- Логика окна без WPF: перенос renderer/renderer.js. Отдельно от окна, чтобы тесты
       гоняли её с поддельным api, как renderer.test.js гоняет renderer.js в заглушке DOM. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SyncGlass.Ui</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SyncGlass.Core\SyncGlass.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SyncGlass.Tests" />
  </ItemGroup>

</Project>
